# PayPal sandbox credentials (never commit real values — this file is an example only).
# Copy to `.env` and fill in your own sandbox app credentials from
# developer.paypal.com → Dashboard → Apps & Credentials → Sandbox.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_ENV=sandbox

# LLM explainer (optional — without a key, template explanations run and are labelled as such).
# Gemini free tier is the chosen provider: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini
